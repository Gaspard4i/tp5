{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "chrome",
			"request": "launch",
			"name": "Debug Reactube dans Chrome",
			"url": "http://localhost:8000",
			"webRoot": "${workspaceFolder}",
			// Dossier de stockage du profil de Chrome en mode debug :
			// Permet de conserver la config et les extensions chrome d'un TP à l'autre (utile pour les react developer tools par ex.).
			// Adaptez si besoin le chemin vers le dossier (par défaut crée un dossier "à côté" du tp)
			"userDataDir": "${workspaceFolder}/../vscode-chrome-profile"
		},
		{
			"type": "chrome",
			"request": "launch",
			"name": "Debug Reactube dans Chromium",
			"url": "http://localhost:8000",
			"webRoot": "${workspaceFolder}",
			"runtimeExecutable": "/bin/chromium",
			"userDataDir": "${workspaceFolder}/../vscode-chrome-profile"
		}
	]
}